# Kopiraj u .env.local i popuni. Isto ide i u Vercel → Settings → Environment Variables.

# Google Cloud → Google Auth Platform → Clients → Desktop app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# npm run google:token
GOOGLE_REFRESH_TOKEN=
# npm run drive:setup
DRIVE_FOLDER_ID=
# npm run key (tajni deo QR linka)
EVENT_KEY=

# Prikazuje se na početnoj strani
NEXT_PUBLIC_COUPLE_NAMES=Ana & Marko
NEXT_PUBLIC_WEDDING_DATE=15. novembar 2026.

# Opciono: max veličina fajla u MB (podrazumevano 2048)
MAX_FILE_MB=
# Opciono: posle ovog trenutka slanje se zatvara, galerija i dalje radi
# UPLOAD_DEADLINE=2026-11-30T23:59:00+01:00
